// TechHire Copilot — data model
//
// Next.js owns this schema and all persistence via Prisma. The FastAPI
// service never touches the database directly — it receives a resume +
// role requirements and returns structured JSON; Next.js is what writes
// that result here. See backend/app/schemas.py for the matching contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CandidateStatus {
  PENDING // uploaded, not yet processed by the AI service
  SCORED // parsed and scored successfully
  FAILED // parsing or scoring failed for this specific resume
}

enum PipelineStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  HIRED
}

model Role {
  id                 String      @id @default(cuid())
  title              String
  description        String      @default("")
  requiredSkills     String[]
  minYearsExperience Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  candidates         Candidate[]
  batches            Batch[]
}

model Candidate {
  id      String @id @default(cuid())
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  fileName String
  fileUrl  String // Supabase Storage path, not the raw file itself

  status       CandidateStatus @default(PENDING)
  errorMessage String?

  // --- Populated once the AI service returns a result ---
  name            String?
  email           String?
  phone           String?
  skills          String[]
  techStack       String[]
  yearsExperience Float?
  summary         String?
  score           Int? // 0-100
  scoreReasoning  String?
  scoredAt        DateTime? // set when status transitions to SCORED — used by analytics

  stage  PipelineStage @default(APPLIED)
  notes  Note[]
  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([batchId])
  @@index([status])
}

// Mirrors auth.users, synced via a Postgres trigger — see Part E.
// id is NOT auto-generated by Prisma; it's always set to match the
// corresponding auth.users.id (a UUID assigned by Supabase Auth).
model Profile {
  id        String   @id
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  notes     Note[]
}

model Note {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    String?
  author      Profile?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body        String
  createdAt   DateTime  @default(now())
}

// A scheduled interview or other event tied to a candidate. This is a
// self-contained internal calendar — no Google/Outlook OAuth, no
// candidate-facing booking flow. "Smart" here means honest conflict
// detection (see POST /api/events), not a full scheduling optimizer.
model Event {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  startTime   DateTime
  endTime     DateTime
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([candidateId])
  @@index([startTime])
}

// Tracks a single bulk-upload run (e.g. "100 resumes for the Backend role
// uploaded on Aug 12") so the frontend can poll /api/batches/{id} for
// progress instead of guessing from the candidate list.
model Batch {
  id         String      @id @default(cuid())
  roleId     String
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  total      Int
  completed  Int         @default(0)
  failed     Int         @default(0)
  status     String      @default("processing") // processing | complete
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  candidates Candidate[]
}