// TechHire Copilot — data model
//
// Next.js owns this schema and all persistence via Prisma. The FastAPI
// service never touches the database directly — it receives a resume +
// role requirements and returns structured JSON; Next.js is what writes
// that result here. See backend/app/schemas.py for the matching contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CandidateStatus {
  PENDING // uploaded, not yet processed by the AI service
  SCORED // parsed and scored successfully
  FAILED // parsing or scoring failed for this specific resume
}

enum PipelineStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  HIRED
}

model Role {
  id                 String      @id @default(cuid())
  teamId             String
  team               Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title              String
  description        String      @default("")
  requiredSkills     String[]
  minYearsExperience Int         @default(0)
  // 0 = weight experience/depth entirely, 100 = weight skill overlap entirely,
  // 50 = balanced. Passed to the AI scorer to bias each candidate's score.
  skillsWeight       Int         @default(50)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  candidates         Candidate[]
  batches            Batch[]
}

model Candidate {
  id      String @id @default(cuid())
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  fileName String
  fileUrl  String // Supabase Storage path, not the raw file itself

  status       CandidateStatus @default(PENDING)
  errorMessage String?

  // --- Populated once the AI service returns a result ---
  name            String?
  email           String?
  phone           String?
  skills          String[]
  techStack       String[]
  yearsExperience Float?
  summary         String?
  score           Int? // 0-100
  scoreReasoning  String?
  scoredAt        DateTime? // set when status transitions to SCORED — used by analytics

  stage      PipelineStage @default(APPLIED)
  notes      Note[]
  events     Event[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([batchId])
  @@index([status])
}

// Mirrors auth.users, synced via a Postgres trigger — see Part E.
// id is NOT auto-generated by Prisma; it's always set to match the
// corresponding auth.users.id. @db.Uuid makes the column a real Postgres
// uuid so the FK to auth.users.id (also uuid) can be created.
model Team {
  id        String    @id @default(cuid())
  name      String
  joinCode  String    @unique
  ownerId   String
  createdAt DateTime  @default(now())
  members   Profile[]
  roles     Role[]
}

// Lightweight per-candidate activity feed (e.g. stage changes), shown on the
// candidate detail page. Cascades away when the candidate is deleted.
model Activity {
  id          String    @id @default(cuid())
  teamId      String
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actorName   String
  message     String
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

// Fixed-window rate-limit counter, one row per (team, action, window). Used
// to cap how often a team can hit cost-bearing AI endpoints.
model RateLimit {
  id          String   @id @default(cuid())
  teamId      String
  kind        String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([teamId, kind, windowStart])
}

model Profile {
  id        String   @id @db.Uuid
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  notes     Note[]
}

model Note {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // uuid to match Profile.id, which it references.
  authorId    String?   @db.Uuid
  author      Profile?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body        String
  createdAt   DateTime  @default(now())
}

// A scheduled interview or other event tied to a candidate. This is a
// self-contained internal calendar — no Google/Outlook OAuth, no
// candidate-facing booking flow. "Smart" here means honest conflict
// detection (see POST /api/events), not a full scheduling optimizer.
model Event {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  startTime   DateTime
  endTime     DateTime
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([candidateId])
  @@index([startTime])
}

// Tracks a single bulk-upload run (e.g. "100 resumes for the Backend role
// uploaded on Aug 12") so the frontend can poll /api/batches/{id} for
// progress instead of guessing from the candidate list.
model Batch {
  id         String      @id @default(cuid())
  roleId     String
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  total      Int
  completed  Int         @default(0)
  failed     Int         @default(0)
  status     String      @default("processing") // processing | complete
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  candidates Candidate[]
}